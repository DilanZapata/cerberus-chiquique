NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://cerberus:cerberus@localhost:5432/cerberus?schema=public

JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# Protege el panel maestro (/master en la web): borra TODA la base de datos
# y crea la primera empresa+admin. Cambiala por una clave larga y unica;
# quien la tenga puede destruir todos los datos de todas las empresas.
MASTER_RESET_PASSWORD=change-me-to-a-long-random-secret

# El SMTP tambien es configurable desde el panel administrativo (tabla email_settings);
# estos valores solo se usan como fallback/semilla inicial.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=TLS
